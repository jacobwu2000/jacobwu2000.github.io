---
import '../styles.css';

const {
  title = 'Ancient Medicine & Healing',
  description = 'A digital humanities study of ancient Greek medicine and healing, combining fieldwork with textual and epigraphic research.',
  mode = 'scholarly', // 'scholarly' | 'journal' — controls the accent color
} = Astro.props;

// Nav is grouped by the site's two strands: the textual research and the
// fieldwork. Groups render with a divider between them.
const navGroups = [
  [{ href: '/', label: 'Home' }],
  [
    { href: '/findings', label: 'Findings' },
    { href: '/sources', label: 'Sources' },
    { href: '/bibliography', label: 'Bibliography' },
  ],
  [
    { href: '/geographies', label: 'Geographies' },
    { href: '/field-journal', label: 'Field Journal' },
    { href: '/epigraphy', label: 'Epigraphy' },
    { href: '/map', label: 'Map' },
  ],
  [{ href: '/about', label: 'About' }],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Ancient Medicine &amp; Healing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__row">
        <a class="site-title" href="/">
          <span class="site-title__main">Ancient Medicine &amp; Healing</span>
          <span class="site-title__sub">Word and Ritual in Greek Sanctuaries</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {navGroups.map((group) => (
            <ul class="site-nav__group">
              {group.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
                </li>
              ))}
            </ul>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>Ancient Medicine &amp; Healing</strong> — a research notebook:
          a close reading of the Hippocratic <em>Epidemics</em> and <em>Airs, Waters, Places</em>,
          with fieldwork at Greek healing sanctuaries, July–August 2026.
        </p>
        <p>
          Work in progress. Text marked <code>[PLACEHOLDER]</code> is scaffolding pending original research and citation.
        </p>
      </div>
    </footer>
  </body>
</html>
